DATABASE_URL=postgres://eventgate:eventgate@127.0.0.1:5432/eventgate
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
BIND=127.0.0.1
GATE_PASSWORD=change-me
TRADING_MODE=mock
NODE_ENV=development
AUTH_MODE=cookie
PUBLIC_URL=http://127.0.0.1:5173
COOKIE_SECURE=0
LETSENCRYPT_EMAIL=

# E*TRADE Market API is chain-only. Never place E*TRADE orders. Default production.
# Keys live in gitignored .env.etrade (never commit, never paste):
#   ETRADE_PROD_KEY / ETRADE_PROD_SECRET
#   ETRADE_PROD_ACCESS_TOKEN / ETRADE_PROD_ACCESS_SECRET
# Refresh overnight tokens from Event Gate (Authorize + PIN on desktop or /m).
# Emergency CLI: node scripts/etrade-oauth.mjs request --env production
# then: node scripts/etrade-oauth.mjs access <PIN> --env production
ETRADE_ENV=production

# Massive Stocks Starter (15-min delayed equities; options chains are E*TRADE). Same key on Mac .env and VPS /opt/broker/.env (gitignored).
# Futures (=F / MES,ZN,6E,M6E,SR3,ES,NQ,MNQ) still use Yahoo. Never log this key.
MASSIVE_API_KEY=

# iOS push notifications via Firebase Cloud Messaging (FCM HTTP v1).
# Disabled by default; fail-closed until explicitly configured on the VPS.
# Credentials should come from application default credentials (adc) or a root-owned JSON file path.
# Never commit credentials and never send them through the Event Gate UI.
PUSH_FCM_ENABLED=0
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CREDENTIAL_SOURCE=adc
PUSH_FCM_CREDENTIAL_PATH=
PUSH_ALERT_DEDUPE_WINDOW_MINUTES=30
