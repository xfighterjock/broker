DATABASE_URL=postgres://eventgate:eventgate@127.0.0.1:5432/eventgate
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
BIND=127.0.0.1
GATE_PASSWORD=change-me
TRADING_MODE=mock
NODE_ENV=development
AUTH_MODE=cookie
PUBLIC_URL=http://127.0.0.1:5173
COOKIE_SECURE=0
LETSENCRYPT_EMAIL=

# E*TRADE Market API is chain-only. Never place E*TRADE orders. Default sandbox.
ETRADE_ENV=sandbox

# Massive Stocks+Options Starter (15-min delayed). Same key on Mac .env and VPS /opt/broker/.env (gitignored).
# Futures (=F / MES,ZN,6E,M6E,SR3,ES,NQ,MNQ) still use Yahoo. Never log this key.
MASSIVE_API_KEY=
